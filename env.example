# ============================================================
#  NBS — env.example   (RULE 7: placeholders only, no secrets)
#  Copy to `.env.local` and fill in real values. NEVER commit
#  `.env.local`. Source of truth: kit `env_readme.md`,
#  kit `.env.example`, kit `NEON_DATABASE_RULES.md`.
# ============================================================


# ------------------------------------------------------------
#  Bundle 1 — Ops Telegram (login / OTP / approval channel)
#  Both required together. Token = WHO sends, chat IDs = WHERE.
#  Also reads TELEGRAM_CHAT_IDS as a legacy alias (lib/telegram.ts).
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_CHAT_IDS=            # legacy alias, only if TELEGRAM_CHAT_ID unset
# ADMIN_PORTAL_URL=            # optional — Control Center origin for approve/deny links


# ------------------------------------------------------------
#  Bundle 2 — SEO admin Telegram (parallel channel)
#  Independent from Bundle 1.
#  REQUIRED on Vercel **Build** env (not Runtime-only) — the IndexNow deploy
#  notify runs from `postbuild`, so a Runtime-only token never fires on deploy.
# ------------------------------------------------------------
TELEGRAM_SEO_BOT_TOKEN=
# Comma-separated chat IDs.
TELEGRAM_SEO_ADMIN=


# ------------------------------------------------------------
#  Bundle 3 / 7 — Neon storage (bot audit + pending login)
#
#  Official primary  : DATABASE_URL   (shard 0, does NOT need CC_ID)
#  Shared primaries  : DB_2 … DB_10  (each needs CC_ID)
#  Backup fallback   : DATABASE_BACKUP_FALLBACK (needs CC_ID)
#  DB_1              : silent alias only — DO NOT SET
#  Shards must be CONTIGUOUS (no gaps) or they are ignored.
#  Requires the `@neondatabase/serverless` package.
# ------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DB_2=postgresql://...
# DB_3=postgresql://...
# DB_4=postgresql://...
# DB_5=postgresql://...
# DB_6=postgresql://...
# DB_7=postgresql://...
# DB_8=postgresql://...
# DB_9=postgresql://...
# DB_10=postgresql://...
# DATABASE_BACKUP_FALLBACK=postgresql://...


# ------------------------------------------------------------
#  Bundle 7 — Pod identity (CC_ID)
#  MUST exactly match the Control Center / admin portal CC_ID.
#  Without it, DB_2…DB_10 and backup writes are silently skipped.
# ------------------------------------------------------------
# CC_ID=YourPodName


# ------------------------------------------------------------
#  Bundle 3 — Site key (DB row isolation). One of:
#    lib/project-config.ts PROJECT_ID / DEFAULT_PROJECT_ID  (preferred)
#    SITE_ID (this env)  |  fallback: VERCEL_PROJECT_NAME
# ------------------------------------------------------------
# SITE_ID=nbs


# ------------------------------------------------------------
#  Bundle 3 — Neon project ids (diagnostics / Control Center
#  Health tab). Optional. NEON_PROJECT_ID_1 … _10.
# ------------------------------------------------------------
# NEON_PROJECT_ID_1=
# NEON_PROJECT_ID_2=
# NEON_PROJECT_ID_3=
# NEON_PROJECT_ID_4=
# NEON_PROJECT_ID_5=
# NEON_PROJECT_ID_6=
# NEON_PROJECT_ID_7=
# NEON_PROJECT_ID_8=
# NEON_PROJECT_ID_9=
# NEON_PROJECT_ID_10=


# ------------------------------------------------------------
#  Bundle 4 — Site URL / IndexNow
#  Canonical origin is hardcoded in lib/site-url.ts; env is an
#  override only. Must match public/{INDEXNOW_KEY}.txt.
# ------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# INDEXNOW_KEY=your-indexnow-key


# ------------------------------------------------------------
#  Bundle 5 — Crawler IP refresh cron (Vercel crons)
#  Vercel sends: Authorization: Bearer <CRON_SECRET>
# ------------------------------------------------------------
# CRON_SECRET=your-secret


# ------------------------------------------------------------
#  Bundle 6 — LOCAL DEV ONLY (ignored when VERCEL_ENV=production)
# ------------------------------------------------------------
# ALLOW_LOCAL_TESTING=1
# CSP=1                         # force CrawlerSeoPage branch; needs layout.tsx OR


# ------------------------------------------------------------
#  Misc — existing target-project keys
#  (app/api/telegram/*, app/api/login-out/route.ts)
# ------------------------------------------------------------
# TURNSTILE_SECRET_KEY=            # Cloudflare Turnstile server secret
# NEXT_PUBLIC_BASE_URL=            # canonical origin, used by /api/login-out
# LOGIN_OUT_PATH=                  # default /Authentication/Handshake
# LOGIN_OUT_URL=                   # explicit override (wins over base+path)
# NEXT_PUBLIC_LOGIN_OUT_URL=
# VERCEL_ENV=production
